<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Family Controls entitlement - Required for Screen Time API -->
    <!-- Uncomment after receiving Apple approval -->
    <!--
    <key>com.apple.developer.family-controls</key>
    <true/>
    -->
    
    <!-- App Groups - For sharing data between main app and extension -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.signals.app</string>
    </array>
</dict>
</plist>
